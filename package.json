{
  "name": "@zigzag-dev/serverless-aws-alias-v3",
  "version": "3.2.3",
  "description": "Serverless v3 plugin to support AWS function aliases",
  "main": "index.js",
  "files": [
    "index.js",
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zigzag-dev/serverless-aws-alias"
  },
  "scripts": {
    "test": "nyc mocha \"test/**/*.js\" -R spec --recursive",
    "lint": "eslint --max-warnings=0 index.js lib eslint.config.js"
  },
  "author": "Frank Schmid <fschmid740@googlemail.com>",
  "license": "MIT",
  "keywords": [
    "serverless",
    "plugin",
    "aws",
    "lambda",
    "alias",
    "aliases"
  ],
  "bugs": {
    "url": "https://github.com/serverless-heaven/serverless-aws-alias/issues"
  },
  "homepage": "https://github.com/zigzag-dev/serverless-aws-alias#readme",
  "nyc": {
    "exclude": [
      "test/**/*.*"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ],
    "report-dir": "./coverage"
  },
  "dependencies": {
    "bluebird": "3.7.2",
    "chalk": "4.1.2",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "chai": "6.3.0",
    "chai-as-promised": "8.0.2",
    "chai-subset": "1.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-lodash": "8.1.0",
    "eslint-plugin-promise": "7.3.0",
    "get-installed-path": "4.0.8",
    "globals": "17.14.0",
    "mocha": "12.0.3",
    "nyc": "18.0.0",
    "serverless": "3.40.0",
    "sinon": "22.1.0",
    "sinon-chai": "4.0.1"
  },
  "overrides": {
    "mocha": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    },
    "nyc": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  }
}
